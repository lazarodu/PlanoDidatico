# Banco de dados (PostgreSQL assíncrono)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/planos_didaticos

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# E-mail via API HTTP (recomendado no Render Free, que bloqueia SMTP)
# Provedor: resend | brevo
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=noreply@cefet.br
EMAIL_FROM_NAME=Planos Didáticos CEFET-MG

# Fallback SMTP (opcional; bloqueado no plano Free do Render)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Telegram (opcional)
# TELEGRAM_BOT_TOKEN=
